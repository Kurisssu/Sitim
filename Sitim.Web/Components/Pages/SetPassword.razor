@page "/set-password"
@attribute [AllowAnonymous]
@layout AuthLayout
@using Sitim.Web.Services
@inject SitimApiClient Api
@inject SitimAuthStateProvider AuthProvider
@inject NavigationManager Navigation

<PageTitle>Setare parolă — SITIM</PageTitle>

<div class="sitim-auth-wrapper">
<RadzenCard class="sitim-auth-card">
    <RadzenStack AlignItems="AlignItems.Center" Gap="0.35rem" class="rz-mb-4">
        <RadzenIcon Icon="biotech" class="sitim-auth-logo" />
        <RadzenText Text="SITIM" TextStyle="TextStyle.H4" class="sitim-auth-title rz-mb-0" />
        <RadzenText Text="Activare cont nou" TextStyle="TextStyle.Body2" class="sitim-auth-subtitle" />
    </RadzenStack>

    @if (_signingOut)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" class="rz-mb-3" Size="AlertSize.Small">
            Sesiunea anterioară a fost închisă. Continuă activarea contului nou mai jos.
        </RadzenAlert>
    }

    @if (_done)
    {
        <RadzenAlert AlertStyle="AlertStyle.Success" AllowClose="false" class="rz-mb-3">
            Parola a fost setată cu succes. Te poți autentifica acum.
        </RadzenAlert>
        <RadzenButton Text="Mergi la autentificare" Icon="login" ButtonStyle="ButtonStyle.Primary"
                      Style="width:100%" Click="@(() => Navigation.NavigateTo("/login", forceLoad: true))" />
    }
    else if (_invalidLink)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">
            Linkul de invitație este invalid sau a expirat. Solicită un link nou administratorului.
        </RadzenAlert>
    }
    else
    {
        <RadzenStack Gap="1rem">
            <RadzenFormField Text="Parolă nouă *" Variant="Variant.Outlined" Style="width:100%">
                <ChildContent>
                    <RadzenPassword @bind-Value="_password" Placeholder="Minim 8 caractere" Style="width:100%" />
                </ChildContent>
            </RadzenFormField>
            <RadzenFormField Text="Confirmare parolă *" Variant="Variant.Outlined" Style="width:100%">
                <ChildContent>
                    <RadzenPassword @bind-Value="_confirm" Placeholder="Repetă parola" Style="width:100%" />
                </ChildContent>
            </RadzenFormField>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" Size="AlertSize.Small">
                    @_error
                </RadzenAlert>
            }

            <RadzenButton Text="Setează parola" Icon="lock" ButtonStyle="ButtonStyle.Primary"
                          Style="width:100%;margin-top:0.25rem"
                          Click="@Submit" IsBusy="@_busy" BusyText="Se procesează..." />
        </RadzenStack>
    }
</RadzenCard>
</div>

@code {
    [SupplyParameterFromQuery] public Guid UserId { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private string _password = "";
    private string _confirm = "";
    private string? _error;
    private bool _busy = false;
    private bool _done = false;
    private bool _invalidLink = false;
    private bool _signingOut = false;

    protected override async Task OnInitializedAsync()
    {
        // An invitation belongs to ONE identity — the recipient. If a different
        // user is already signed in on this browser (e.g. an admin opened the
        // link), force-logout them first so the new account isn't created in
        // a confused mixed-identity state.
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated == true)
        {
            await AuthProvider.LogoutAsync();
            _signingOut = true;
        }

        if (UserId == Guid.Empty || string.IsNullOrWhiteSpace(Token))
            _invalidLink = true;
    }

    private async Task Submit()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_password) || _password.Length < 8)
        {
            _error = "Parola trebuie să aibă cel puțin 8 caractere.";
            return;
        }
        if (_password != _confirm)
        {
            _error = "Parolele nu coincid.";
            return;
        }

        _busy = true;
        var ok = await Api.SetPasswordAsync(UserId, Token!, _password);
        _busy = false;

        if (ok)
        {
            _done = true;
        }
        else
        {
            _error = "Linkul a expirat sau parola nu respectă cerințele (minim 8 caractere, literă mare, cifră, caracter special).";
        }
    }
}
